model User {
  id             String          @id @default(uuid())

  // Basic Info
  name           String
  email          String          @unique
  password       String

  avatar         String?
  phone          String?

  // Profile
  bio            String?
  gender         Gender?
  dateOfBirth    DateTime?

  occupation     String?

  address        String?
  city           String?
  state          String?
  country        String?
  zipCode        String?

  // Social
  website        String?
  github         String?
  linkedin       String?
  facebook       String?

  // Landlord Stats
  isSuperhost    Boolean         @default(false)
  isVerified     Boolean         @default(false)

  rating         Float           @default(0)

  responseRate   String?
  responseTime   String?

  // System
  role           Role
  status         UserStatus      @default(ACTIVE)

  properties     Property[]
  rentalRequests RentalRequest[]
  reviews        Review[]
  payments       Payment[]
  wishlists      Wishlist[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}